# ==============================================================================
# CampusAgent AI — Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   1) `backend/.env` for backend FastAPI services
#   2) `frontend/.env.local` for frontend Next.js application
#
# NOTE: Never commit real credentials, private keys, or API tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------

# Database (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=campusagent

# Authentication & Security
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq LLM Inference (https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Hugging Face Inference API (Embeddings: sentence-transformers/all-MiniLM-L6-v2)
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_hugging_face_user_access_token_here

# Vector Database (Qdrant Cloud: https://cloud.qdrant.io/)
# Leave blank to use local embedded storage ('qdrant_storage'), or supply cloud credentials:
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here


# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------

# FastAPI Backend Endpoint
# Local development: http://127.0.0.1:8000
# Production deployment: https://campusagent-ai-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
